COL <- list(
white        = "#FFFFFF",
black        = "#000000",
red          = "#FF0000",
# Section header fills
fill_green_hdr   = "#D7E3BC",   # A3 / B4 rows  (theme=6, tint=0.60)
fill_blue_hdr    = "#388194",   # P3 Disbursement dark-blue (theme=8, tint=-0.25)
fill_green_fade_hdr    = "#186174",   # P3 Disbursement dark-blue (theme=8, tint=-0.25)
fill_blue_sub    = "#D2DAE5",   # P4 Cumulative  (theme=3, tint=0.80)
fill_green_init  = "#00D093",   # AH3/AZ4 Initiating Loan  (pure green)
fill_yellow_mon  = "#FFFF00",   # AQ3/BC4 Monitoring Loan  (pure yellow)
fill_orange_par  = "#FAC090",   # AZ3 PAR section (theme=9, tint=0.40)
fill_portfolio_1 = "#dddddd",   # P4 Cumulative  (theme=3, tint=0.80)
fill_portfolio_2 = "#bbbbbb",   # P4 Cumulative  (theme=3, tint=0.80)
fill_portfolio_3 = "#999999",   # P4 Cumulative  (theme=3, tint=0.80)
fill_team        = "#c6e0b4",   # P4 Cumulative  (theme=3, tint=0.80)
fill_branch      = "#FAC090",   # P4 Cumulative  (theme=3, tint=0.80)
# Font colours
font_blue_title  = "#182194",   # A3 row font  (theme=8)
font_red         = "#FF0000",   # dates / X separators
font_white       = "#FFFFFF"    # on dark fills
)
# Pre-built named styles
ST <- list(
# Row 1-2 title / info (no fill, no border)
title       = make_style(bold = TRUE,  halign = "left",  wrap = FALSE, border = FALSE),
date_red    = make_style(bold = TRUE,  font_color = COL$font_red, halign = "left", border = FALSE, numFmt = "DD-MMM-YY"),
date_red_bg = make_style(bold = TRUE,  font_color = COL$font_red, bg_color = COL$fill_yellow_mon, halign = "left", border = FALSE, numFmt = "DD-MMM-YY"),
# Row 3 section headers
green_hdr   = make_style(bold = TRUE,bg_color = COL$fill_green_hdr,  font_color = COL$font_blue_title),
blue_hdr    = make_style(bold = TRUE,bg_color = COL$fill_blue_hdr,   font_color = COL$white),
Initiating  = make_style(bold = TRUE,bg_color = COL$fill_green_init, font_color = COL$black),
Monitoring  = make_style(bold = TRUE,bg_color = COL$fill_yellow_mon, font_color = COL$red),
par_hdr     = make_style(bold = TRUE,bg_color = COL$fill_orange_par, font_color = COL$black),
fade_green_hdr     = make_style(bold = TRUE,bg_color = COL$fill_green_fade_hdr, font_color = COL$white),
# Row 4-5 sub-headers
blue_sub    = make_style(bold = TRUE, bg_color = COL$fill_blue_sub,    font_color = COL$black),
green_sub   = make_style(bold = TRUE, bg_color = COL$fill_green_hdr,   font_color = COL$black),
portfolio_1 = make_style(bold = TRUE, bg_color = COL$fill_portfolio_1, font_color = COL$black),
portfolio_2 = make_style(bold = TRUE, bg_color = COL$fill_portfolio_2, font_color = COL$black),
portfolio_3 = make_style(bold = TRUE, bg_color = COL$fill_portfolio_3, font_color = COL$black),
par_sub     = make_style(bold = TRUE, bg_color = COL$fill_orange_par,  font_color = COL$black),
plain_sub   = make_style(bold = TRUE, bg_color = NULL,                 font_color = COL$black),  # Month/Year sub-headers
# Special: WALR in red font
walr_green  = make_style(bold = TRUE, bg_color = COL$fill_green_hdr,  font_color = COL$red),
walr_plain  = make_style(bold = TRUE, bg_color = NULL,                font_color = COL$red),
# Separator X cells
sep_x            = make_style(font_color = COL$red, border = FALSE),
default          = make_style(, wrap = FALSE),
default_team     = make_style(bg_color = COL$fill_team, wrap = FALSE),
default_branch   = make_style(bg_color = COL$fill_branch, wrap = FALSE),
name             = make_style(halign="left", wrap = FALSE),
name_team        = make_style(halign="left", bg_color = COL$fill_team, wrap = FALSE),
name_branch      = make_style(halign="left", bg_color = COL$fill_branch, wrap = FALSE),
date             = make_style(numFmt = "DD-MMM-YY", wrap = FALSE),
date_team        = make_style(numFmt = "DD-MMM-YY", bg_color = COL$fill_team, wrap = FALSE),
date_branch        = make_style(numFmt = "DD-MMM-YY", bg_color = COL$fill_branch, wrap = FALSE),
amt              = make_style(numFmt = "#,##0;(#,##0);\"-\"", halign="right", wrap = FALSE),
amt_team         = make_style(numFmt = "#,##0;(#,##0);\"-\"", halign="right", bg_color = COL$fill_team, wrap = FALSE),
amt_branch         = make_style(numFmt = "#,##0;(#,##0);\"-\"", halign="right", bg_color = COL$fill_branch, wrap = FALSE),
pct_0            = make_style(numFmt = "0%", wrap = FALSE),
pct_0_team       = make_style(numFmt = "0%", bg_color = COL$fill_team, wrap = FALSE),
pct_0_branch       = make_style(numFmt = "0%", bg_color = COL$fill_branch, wrap = FALSE),
pct_2            = make_style(numFmt = "0.00%", wrap = FALSE),
pct_2_team       = make_style(numFmt = "0.00%", bg_color = COL$fill_team, wrap = FALSE),
pt_st            = make_style(numFmt = "0.00", wrap = FALSE),
pt_st_b          = make_style(numFmt = "0.00", wrap = FALSE, bold = TRUE)
)
RBH <-   get_rbh_map(con)
format_reselling <- function(df, last_day_mon){
sheet_name <- paste0("ResellingLeadCreation | ", month(last_day_mon, label = TRUE), " - ", year(last_day_mon))
last_col <- ncol(df)
wb <- openxlsx::createWorkbook()
addWorksheet(wb, sheet=sheet_name, tabColour = "red")
colNames <- c(
"CUSTOMER_NO",
"CLIENTNAME",
"Branch Name",
"Proposed RM Code",
"Proposed RM Name",
paste0("Role as of ", month(last_day_mon, label = TRUE), " ", day(last_day_mon),", ", year(last_day_mon)),
"LeadReferenceNo"
)
writeData(
wb,
sheet = sheet_name,
x = t(data.frame(cols = colNames)),
startRow = 1,
startCol = 1,
colNames = FALSE
)
apply_range(wb, sheet_name,  ST$portfolio_1, rows=1, cols=1:last_col)
name_col <- c(2,3,4)
writeData(
wb,
sheet = sheet_name,
x = df,
startRow = 2,
colNames = FALSE,
rowNames = FALSE
)
apply_range(wb, sheet_name, ST$default, rows=(1:nrow(df))+1, cols=1:last_col)
apply_range(wb, sheet_name, ST$name,    rows=(1:nrow(df))+1, cols=name_col)
# Row heights (from template)
setRowHeights(wb, sheet_name, rows = 1, heights = 18.0)
setRowHeights(wb, sheet_name, rows = 2, heights = 37.8)
# Column widths (from template)
col_widths <- c(
A=15,    B=40,  C=25,  D=20, E=40,  F=25,  G=20
)
setColWidths(wb,
sheet_name,
cols   = 1:last_col,
widths = c(unname(col_widths), c(23, 23, 30, 18))
)
addFilter(wb, sheet_name, row = 1, cols = 1:last_col)
freezePane(
wb,
sheet_name,
firstActiveRow = 2,
firstActiveCol = 1
)
return(wb)
}
