halign         = halign,
valign         = "center",
wrapText       = wrap,
numFmt         = numFmt,
border         = if (border) "TopBottomLeftRight" else NULL,
borderStyle    = if (border) "thin" else NULL,
borderColour   = if (border) COL$black else NULL
)
}
# Helper: apply a style to a range of cells
apply_range <- function(wb, sheet, style, rows, cols) {
addStyle(wb, sheet, style, rows = rows, cols = cols, gridExpand = TRUE, stack = FALSE)
}
get_rbh_map <- function(con_arg = NULL) {
db_con <- if (!is.null(con_arg)) con_arg else con
tbl(db_con, DBI::Id(schema = "SME", table = "BusinessEmployees")) %>%
filter(Month == max(Month, na.rm = TRUE)) %>%
select(Branch, RBH) %>%
distinct() %>%
mutate(Branch = str_trim(Branch), RBH = str_trim(RBH)) %>%
collect()
}
get_last_day_of_month <- function(date){
ceiling_date(date, "month")-1
}
create_file_name <- function(file, initial, last_day_mon) {
clean_initial <- str_replace_all(initial, "[()]", "") %>%
str_replace_all(" ", "_")
paste0(
file, "_",
clean_initial, "_",
month(last_day_mon, label = TRUE), "_",
year(last_day_mon),
".xlsx"
)
}
destination_path <- function(base_path, branch=NULL, last_day_mon) {
base_path <- str_replace(base_path, "/?$", "/")  # ensure trailing slash
branch <- ifelse(is.null(branch), "", paste0(branch, "/"))
paste0(
base_path, branch,
month(last_day_mon), ". ", month(last_day_mon, label = TRUE, abbr = FALSE), " ", year(last_day_mon),
"/"
)
}
