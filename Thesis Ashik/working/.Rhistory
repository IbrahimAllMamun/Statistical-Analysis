mis_index_x1
mis_index_x3
true_x1
true_x3
results_cont
results_cat
set.seed(123)
# Parameters
n <- 300
beta0 <- 1.5
beta1 <- 2
beta2 <- -1
beta3 <- 2.1
m <- 5
R <- 3
rho <- 0.6
# Correlation structure
Sigma <- matrix(c(1, rho, rho, 1), 2)
X <- mvrnorm(n, mu = c(0, 0), Sigma = Sigma)
x1 <- X[,1]
x2 <- X[,2]
# Generate categorical variable using rbinom()
prob <- 1 / (1 + exp(-(0.5 + 1.2*x1 - 0.8*x2)))
x3 <- as.factor(rbinom(n, 1, prob))
# Generate outcome variable
Y <- beta0 + beta1*x1 + beta2*x2 + beta3*(as.numeric(as.character(x3))) + rnorm(n)
dat_full <- data.frame(x1, x2, x3, Y)
# Create MAR missingness pattern using ampute()
# 20% missing in both x1 (continuous) and x3 (categorical)
amp <- ampute(
data = dat_full,
prop = 0.2,
mech = "MAR",
patterns = matrix(c(
0,1,1,1,   # Missing x1
1,1,0,1    # Missing x3
), nrow = 2, byrow = TRUE),
freq = c(0.5, 0.5),
weights = matrix(c(
0,1,1,1,  # weights for pattern 1
1,1,0,1   # weights for pattern 2
), nrow = 2, byrow = TRUE)
)
dat_mar <- amp$amp
# Index of missing values
mis_index_x1 <- is.na(dat_mar$x1)
mis_index_x3 <- is.na(dat_mar$x3)
true_x1 <- dat_full$x1
true_x3 <- dat_full$x3
# Containers
results_cont <- data.frame(Method = character(), MSE = numeric())
results_cat <- data.frame(Method = character(), Accuracy = numeric())
# --- JM (norm)
imp_jm <- mice(dat_mar, method = c("norm", "norm", "logreg", "norm"), m = m, print = FALSE)
mse_vals <- sapply(1:m, function(i){
dat_imp <- complete(imp_jm, i)
mean((dat_imp$x1[mis_index_x1] - true_x1[mis_index_x1])^2)
})
mse_jm <- mean(mse_vals)
fit_jm <- with(imp_jm, lm(Y ~ x1 + x2 + x3))
pool_jm <- pool(fit_jm)
bias_jm <- summary(pool_jm)$estimate - c(beta0, beta1, beta2, beta3)
# Accuracy for categorical (x3)
acc_jm <- sapply(1:m, function(i){
dat_imp <- complete(imp_jm, i)
mean(dat_imp$x3[mis_index_x3] == true_x3[mis_index_x3])
})
acc_jm <- mean(acc_jm)
# --- FCS (pmm + logistic)
imp_fcs <- mice(dat_mar, method = c("pmm", "pmm", "logreg", "norm"), m = m, print = FALSE)
mse_vals_fcs <- sapply(1:m, function(i){
dat_imp <- complete(imp_fcs, i)
mean((dat_imp$x1[mis_index_x1] - true_x1[mis_index_x1])^2)
})
mse_fcs <- mean(mse_vals_fcs)
fit_fcs <- with(imp_fcs, lm(Y ~ x1 + x2 + x3))
pool_fcs <- pool(fit_fcs)
bias_fcs <- summary(pool_fcs)$estimate - c(beta0, beta1, beta2, beta3)
acc_fcs <- sapply(1:m, function(i){
dat_imp <- complete(imp_fcs, i)
mean(dat_imp$x3[mis_index_x3] == true_x3[mis_index_x3])
})
acc_fcs <- mean(acc_fcs)
# RF (random forest)
imp_rf <- mice(dat_mar, method = c("rf", "rf", "rf", "norm"), m = m, print = FALSE)
mse_vals_rf <- sapply(1:m, function(i){
dat_imp <- complete(imp_rf, i)
mean((dat_imp$x1[mis_index_x1] - true_x1[mis_index_x1])^2)
})
mse_rf <- mean(mse_vals_rf)
fit_rf <- with(imp_rf, lm(Y ~ x1 + x2 + x3))
pool_rf <- pool(fit_rf)
bias_rf <- summary(pool_rf)$estimate - c(beta0, beta1, beta2, beta3)
acc_rf <- sapply(1:m, function(i){
dat_imp <- complete(imp_rf, i)
mean(dat_imp$x3[mis_index_x3] == true_x3[mis_index_x3])
})
acc_rf <- mean(acc_rf)
# Combine results
results_cont <- rbind(results_cont,
data.frame(Method = c("JM","FCS","RF"),
MSE = c(mse_jm, mse_fcs, mse_rf)))
results_cat <- rbind(results_cat,
data.frame(Method = c("JM","FCS","RF"),
Accuracy = c(acc_jm, acc_fcs, acc_rf)))
# Continuous variable (x1)
ggplot(results_cont, aes(x = Method, y = MSE, fill = Method)) +
geom_bar(stat = "identity", position = "dodge") +
theme_minimal() +
ggtitle("MSE Comparison for Continuous Variable (x1)")
# Categorical variable (x3)
ggplot(results_cat, aes(x = Method, y = Accuracy, fill = Method)) +
geom_bar(stat = "identity", position = "dodge") +
theme_minimal() +
ggtitle("Accuracy Comparison for Categorical Variable (x3)")
