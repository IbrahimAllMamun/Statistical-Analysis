library(stringr)
text <- "No RWMA,LVEF-55%"
str_extract(text, "\\d+")
str_extract(text, "\\d+") %>% as.integer()
data %>%
rowwise() %>%
mutate(
RWMA = any(stringr::str_detect(Echocardiography, c("No RWMA","NO RWMA"))),
num = str_extract(Echocardiography, "\\d+") %>% as.integer()
) %>% select(RWMA , Echocardiography) -> new_data
data %>%
rowwise() %>%
mutate(
RWMA = any(stringr::str_detect(Echocardiography, c("No RWMA","NO RWMA"))),
num = str_extract(Echocardiography, "\\d+") %>% as.integer()
) %>% select(RWMA , num, Echocardiography) -> new_data
new_data
View(new_data)
