data %>%
mutate(
RWMA = any(stringr::str_detect(Echocardiography, c("No RWMA","NO RWMA")))
) %>% select(RWMA , Echocardiography) -> new_data
data %>%
mutate(
RWMA = any(stringr::str_detect(Echocardiography, c("No RWMA","NO RWMA")))
) %>% select(RWMA , Echocardiography) -> new_data
any(stringr::str_detect(data$Echocardiography[4], c("No RWMA","NO RWMA")))
data %>%
rowwise() %>%
mutate(
RWMA = any(stringr::str_detect(Echocardiography, c("No RWMA","NO RWMA")))
) %>% select(RWMA , Echocardiography) -> new_data
