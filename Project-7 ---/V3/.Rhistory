# ============================================================
table1 <- data %>%
select(age_grp, Education, family_hist, stage, subtype, mbc_type, menopause,
histology, grading, Lung, Liver, Brain, Bone, Opposite_breast) %>%
tbl_summary(
statistic = list(all_continuous() ~ "{mean} ({sd})",
all_categorical() ~ "{n} ({p}%)"),
digits  = all_continuous() ~ 2,
missing = "no",
label = list(
