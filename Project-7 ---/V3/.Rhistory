select(status, grading, subtype, mburden, Lung, Liver, Brain,Bone, delayrx, skip) %>%
tbl_summary(
by = status,
statistic = list(all_continuous() ~ "{mean} ({sd})",
all_categorical() ~ "{n} ({p}%)"),
digits  = all_continuous() ~ 2,
missing = "no",
label = list(
grading ~ "Tumor grade",
subtype ~ "Molecular subtype",
mburden ~ "Metastatic burden",
