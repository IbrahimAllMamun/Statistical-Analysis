.default = NA_character_) %>% factor(levels = c("1 site", "2-3 sites", ">3 sites")),
# ── treatments (already No/Yes) ──
Chemotherapy     = yn(Chemotherapy),
Hormone_Therapy  = yn(Hormone_Therapy),
