# Basic Kaplan-Meier plot
ggsurvplot(
km_fit,
data=data,
conf.int = T,            # show number at risk
xlab = "Time of Death (months)",
ylab = "Survival Probability",
palette = "Red",
legend = "none"
)
ggsurvplot(
km_fit,
data=data,
conf.int = T,            # show number at risk
xlab = "Time of Death (months)",
ylab = "Survival Probability",
palette = "Red",
legend = "none"
)
surv_obj <- Surv(time = data$timeofdeath, event = data$status)
km_fit <- survfit(surv_obj ~ 1, data = data)
library(dplyr)
library(survival)
km_list <- list()
vars <- c("Lung", "Brain", "Liver", "Bone", "opposite_breast", "Others")
for (i in vars) {
# Use tidy evaluation to filter column by name
km_fit <- survfit(Surv(timeofdeath, status) ~ 1,
data = (data %>% filter(!!sym(i) == "Yes")))  # assuming dummy 1 = Yes
# Convert survfit object to a tidy data frame
km_list[[i]] <- data.frame(
time = km_fit$time,
surv = km_fit$surv
)
}
library(ggplot2)
p <- ggplot()
for (i in 1:length(vars)) {
p <- p + geom_step(data=km_list[[vars[i]]], aes(x = time, y = surv), size = .8, color=cl[i])
}
p + labs(
title = "Kaplan–Meier Survival Curve",
x = "Time",
y = "Survival Probability"
) +
theme_minimal() +
theme(
legend.title = element_blank(),
text = element_text(size = 14)
)
library(ggplot2)
library(dplyr)
vars <- c("Lung", "Brain", "liver", "Bone", "opposite_breast", "Others")
cl <- RColorBrewer::brewer.pal(12,"Paired")[seq(2,12,2)] # distinct contrasting colors
# Combine KM datasets into one long data frame
km_combined <- bind_rows(
lapply(vars, function(v) {
df <- km_list[[v]]
df$group <- v
df
})
)
# Plot
ggplot(km_combined, aes(x = time, y = surv, color = group)) +
geom_step(size = 1) +
scale_color_manual(values = cl) +  # assign colors
labs(
title = "Kaplan–Meier Survival Curves by Metastasis Site",
x = "Time",
y = "Survival Probability",
color = "Metastasis"               # legend title
) +
theme_minimal() +
theme(
text = element_text(size = 14)
)
ggplot(km_combined, aes(x = time, y = surv, color = group)) +
geom_step(size = 1) +
scale_color_manual(values = cl) +  # assign colors
labs(
title = "Kaplan–Meier Survival Curves by Metastasis Site",
x = "Time",
y = "Survival Probability",
color = "Metastasis"               # legend title
) +
theme_minimal() +
theme(
text = element_text(size = 14)
)
km_combined$group <- factor(
km_combined$group,
levels = c("Lung", "Brain", "liver", "Bone", "opposite_breast", "Others"),
